# Dane logowania dla organizatora (domyślnie: organizator / rysie2026)
ADMIN_LOGIN=organizator
ADMIN_PASSWORD=rysie2026

# (Opcjonalnie) Upstash Redis - jeśli chcesz, aby wielu organizatorów liczyło głosy
# na żywo w czasie rzeczywistym z różnych telefonów jednocześnie (darmowa baza z 1 kliknięciem w Vercel):
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
